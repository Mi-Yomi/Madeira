{
  "ntdll": [
    "-arch",
    "arm64",
    "-isysroot",
    "/fixture iPhoneOS.sdk",
    "-miphoneos-version-min=17.0",
    "-O2",
    "-fPIC",
    "-fvisibility=hidden",
    "-fno-stack-protector",
    "-fno-strict-aliasing",
    "-Wno-implicit-function-declaration",
    "-Wno-int-conversion",
    "-include",
    "<ROOT>/wine/build-macos/include/config.h",
    "-include",
    "<ROOT>/build/ntdll-unix/shims/wine_ios_exit.h",
    "-I<ROOT>/build/ntdll-unix/shims",
    "-I<ROOT>/build/ntdll-unix/../madsync",
    "-DHAVE_LINUX_NTSYNC_H=1",
    "-I<ROOT>/wine/build-macos/dlls/ntdll",
    "-I<ROOT>/wine/dlls/ntdll",
    "-I<ROOT>/wine/dlls/ntdll/unix",
    "-I<ROOT>/wine/build-macos/include",
    "-I<ROOT>/wine/include",
    "-D__WINESRC__",
    "-DLTC_NO_PROTOTYPES",
    "-DLTC_SOURCE",
    "-D_NTSYSTEM_",
    "-D_ACRTIMP=",
    "-DWINBASEAPI=",
    "-DBINDIR=\"/usr/local/bin\"",
    "-DLIBDIR=\"/usr/local/lib\"",
    "-DDATADIR=\"/usr/local/share\"",
    "-DSYSTEMDLLPATH=\"\"",
    "-DWINE_UNIX_LIB",
    "-DWINE_IOS=1",
    "-Dget_thread_context=ntdll_get_thread_context",
    "-Dset_thread_context=ntdll_set_thread_context",
    "-c",
    "<SOURCE>",
    "-o",
    "<OBJECT>"
  ],
  "win32u": [
    "-arch",
    "arm64",
    "-isysroot",
    "/fixture iPhoneOS.sdk",
    "-miphoneos-version-min=17.0",
    "-O2",
    "-fPIC",
    "-fvisibility=hidden",
    "-fno-stack-protector",
    "-fno-strict-aliasing",
    "-Wno-implicit-function-declaration",
    "-Wno-int-conversion",
    "-include",
    "<ROOT>/build/win32u-unix/config_ios.h",
    "-include",
    "<ROOT>/build/ntdll-unix/shims/wine_ios_exit.h",
    "-I<ROOT>/build/win32u-unix",
    "-I<ROOT>/wine/build-macos/include",
    "-I<ROOT>/build/ntdll-unix/shims",
    "-I<ROOT>/wine/build-macos/dlls/win32u",
    "-I<ROOT>/wine/dlls/win32u",
    "-I<ROOT>/wine/build-macos/include",
    "-I<ROOT>/wine/include",
    "-D__WINESRC__",
    "-D_WIN32U_",
    "-D_ACRTIMP=",
    "-DWINBASEAPI=",
    "-DSYSTEMDLLPATH=\"\"",
    "-DWINE_UNIX_LIB",
    "-DWINE_IOS=1",
    "-D__wine_unix_lib_init=win32u_unix_lib_init",
    "-USONAME_LIBFREETYPE",
    "-USONAME_LIBFONTCONFIG",
    "-USONAME_LIBEGL",
    "-USONAME_LIBVULKAN",
    "-USONAME_LIBGNUTLS",
    "-UHAVE_FT2BUILD_H",
    "-c",
    "<SOURCE>",
    "-o",
    "<OBJECT>"
  ]
}
