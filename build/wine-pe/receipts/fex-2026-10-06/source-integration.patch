+  // generation; IosSyscallArmed/IosSyscallDepth are owner-only.
+  volatile uint8_t IosInSim {1};
+  volatile uint8_t IosMigrated {0};
+  bool IosSyscallArmed {};
+  bool IosSweepRegistered {};
+  uint32_t IosSyscallDepth {};
