+                ["-D", "FEX_IOS_HOST=0"], ["-DFEX_IOS_HOST="], ["-UARCHITECTURE_arm64ec"],
+                ["-UFEX_GUEST_WINDOW"], ["-DFEX_GUEST_WINDOW=0"],
+                ["--target=x86_64-w64-mingw32"], ["--target", "x86_64-w64-mingw32"],
